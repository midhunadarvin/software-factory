    "@ai-sdk/openai-compatible": "3.0.55",
    "@ai-sdk/xai": "5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@dagrejs/dagre": "^3.1.1",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@software-factory/agent-sdk": "workspace:*",
    "@strands-agents/sdk": "^1.19.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@uiw/react-codemirror": "^4.25.1",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.113",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "mermaid": "^12.0.0",
    "next": "^16.3.6",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
