    "next": "^15.5.2",
    "postcss": "^8.5.26",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
