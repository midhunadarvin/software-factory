{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "docker:build": "docker build -t software-factory .",
    "docker:up": "docker compose up --build -d",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "seed:board": "tsx src/scripts/seed-board.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
