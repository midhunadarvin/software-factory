{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "docker:build": "docker build -t software-factory .",
    "docker:up": "docker compose up --build -d",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "seed:board": "tsx src/scripts/seed-board.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/openai": "^4.0.94",
    "@ai-sdk/openai-compatible": "3.0.69",
    "@ai-sdk/xai": "5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@dagrejs/dagre": "^3.1.1",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@software-factory/agent-sdk": "workspace:*",
    "@strands-agents/sdk": "^1.21.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.141",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.1",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
