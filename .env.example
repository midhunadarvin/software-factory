# 64 hex chars OR base64:<payload of at least 32 bytes>
FACTORY_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FACTORY_APP_PASSWORD=change-me
# Public URL browsers and webhook providers use. In Docker this must be reachable
# from the internet (or your tunnel), e.g. https://factory.example.com
FACTORY_ORIGIN=http://localhost:3000
# Listen address. Use 0.0.0.0:3000 when running in Docker.
FACTORY_BIND=127.0.0.1:3000
FACTORY_VAR_MAX_GB=20
# Optional override for cloned / attached git repos (Docker default is /repos)
# FACTORY_REPOS_DIR=/repos

# Required — factory stays locked until GET {provider}/models succeeds
# Default provider is OpenCode Go (https://opencode.ai/zen/go/v1)
# FACTORY_LLM_API_KEY=sk-...
# OPENCODE_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
# LLM_PROVIDER=opencode_go
# Optional /v1 root override (custom hosts, or pin OpenAI/xAI)
# OPENAI_COMPAT_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_COMPAT_MODEL=glm-5.3-flash

# Webhook signing secrets (required for each provider you enable)
# GITHUB_WEBHOOK_SECRET=
# LINEAR_WEBHOOK_SECRET=
# JIRA_WEBHOOK_SECRET=

# Optional: decrypt PATs written with a previous secret
# FACTORY_SECRET_OLD=
